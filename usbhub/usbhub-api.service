# USB hub port power, as root, on loopback.
#
# The webserver container cannot do this itself: Docker mounts its
# /sys/devices read-only, so writing <hub>:1.0/<hub>-portN/disable fails with
# EACCES even though the container is privileged (verified 2026-10-18). The
# Coolgear hub was controllable from the container only because its path is a
# character device, /dev/coolgear-hub. A plain powered hub has no control chip,
# so the kernel is the only way in -- hence this service.
#
# Same shape as wifi-api-rp5.service: stdlib only, loopback, no auth because
# the bind address IS the access control.
[Unit]
Description=USB hub port power API (root, loopback)
After=network.target
# No dependency on the hub being present: the service answers /api/hubs with
# whatever exists, which is what makes it useful for probing a new hub.

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/sbin/usbhub_api.py
User=root
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=LC_ALL=C
Environment=LANG=C

# NEVER set this to 0.0.0.0 or to br0. br0 carries RV guest devices, and this
# service can power down the RV's internet.
Environment=USBHUB_API_BIND=127.0.0.1
Environment=USBHUB_API_PORT=12347
Environment=USBHUB_API_ALLOWED_NET=127.0.0.0/8

# Ports that must never be switched off, "hub:port" comma separated.
#
# Any port carrying another hub is protected automatically and need not be
# listed -- a hub's upstream port, and the internal cascade that fronts four of
# the Plugable's seven sockets (measured: 3-1:3 and 4-1:3). Cutting one of
# those takes out everything behind it.
#
# 1-2:4 is the Coolgear's own FT232R control chip: cut it and the old hub
# cannot be steered at all, which is a control loss rather than an internet
# loss. 1-2:3 is the USB-ethernet adapter carrying the live WAN -- listed while
# the Coolgear is still the WAN switch, because that path is steered over
# serial (webserver/usbhub_ascii.py), not through this service, so protecting
# it here costs nothing and stops an accidental cut of the only uplink.
# Remove 1-2:3 once the WAN devices move to the Plugable.
Environment=USBHUB_PROTECTED=1-2:4,1-2:3

# Where the physical-socket map lives. Built by map_sockets.py -- socket
# numbers cannot be derived from sysfs, they have to be observed. Absent is a
# normal state: the socket endpoints then answer 409 rather than guessing.
Environment=USBHUB_SOCKET_MAP=/etc/usbhub/sockets.json

EnvironmentFile=-/etc/default/usbhub-api

[Install]
WantedBy=multi-user.target
