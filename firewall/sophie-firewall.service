[Unit]
Description=Sophie host firewall (default-deny on uplinks)
DefaultDependencies=no
# netfilter-persistent's iptables-restore flushes the whole filter table, which
# deletes our chains and hooks. It must finish before we build (README.md "Traps").
After=local-fs.target netfilter-persistent.service
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/sophie-firewall.sh apply

[Install]
WantedBy=multi-user.target
