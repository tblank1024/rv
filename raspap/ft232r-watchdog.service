[Unit]
Description=Coolgear USB switch FT232R control-chip watchdog
Documentation=https://github.com/tblank1024/rv
After=network.target
# Not Requires=: the watchdog is useful even if other services are down.

[Service]
Type=simple
User=root
ExecStart=/usr/local/sbin/ft232r-watchdog.sh
Restart=always
RestartSec=10
# The script writes its own timestamped log; keep journal noise down.
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
