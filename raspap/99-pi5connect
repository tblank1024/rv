#!/bin/bash
# filepath: /etc/NetworkManager/dispatcher.d/99-pi5connect

MAIN_SCRIPT="/usr/local/sbin/pi5connect.sh"
LOG_FILE="/var/log/pi5connect.log"
EXCLUDE_IFACES=("lo" "eth0" "wlan0" "br0" "docker0")

IFACE="$1"
STATUS="$2"

containsElement () {
  local element match="$1"
  shift
  for element; do [[ "$element" == "$match" ]] && return 0; done
  return 1
}

is_uplink=false

# Match ethernet (eth*, enx*, usb*) and non-AP wifi (wlan1, wlan2, ...)
if [[ "$IFACE" == enx* || "$IFACE" == eth* || "$IFACE" == usb* ]] || \
   [[ "$IFACE" == wlan* && "$IFACE" != "wlan0" ]]; then
    if ! containsElement "$IFACE" "${EXCLUDE_IFACES[@]}"; then
        is_uplink=true
        echo "[$(date)] Dispatcher: potential uplink $IFACE $STATUS" >> "$LOG_FILE"
    fi
fi

# dhcp4-change matters: NM fires "up" as soon as the link is usable, which can be
# BEFORE DHCP returns a gateway. pi5connect then logs "cannot determine gateway"
# and exits, and without dhcp4-change here nothing re-runs it, so that WAN is
# never selected. Observed 2026-10-17: the cellular port took 37s to get its
# lease, "up" fired at 11:51:18 with no gateway, the lease landed at 11:51:19,
# and nothing re-evaluated. That race is why a slow-DHCP uplink intermittently
# "did not work" while a fast one did.
if $is_uplink && [[ "$STATUS" == "up" || "$STATUS" == "down" \
                 || "$STATUS" == "connectivity-change" || "$STATUS" == "dhcp4-change" ]]; then
    echo "[$(date)] Dispatcher: triggering pi5connect for $IFACE $STATUS" >> "$LOG_FILE"
    # Pass interface and status so pi5connect.sh uses them directly
    "$MAIN_SCRIPT" "$IFACE" "$STATUS" &
fi

exit 0
